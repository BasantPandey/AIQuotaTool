{
  "name": "ai-quota-tool-vscode",
  "displayName": "AI Quota Tool",
  "description": "See remaining AI quota for Claude, Copilot, Codex, Grok and Cursor, plus API key spend. Sign-in opens Chrome or Edge in a new profile and reads one session cookie.",
  "version": "0.9.1",
  "publisher": "BasantPandey",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BasantPandey/AIQuotaTool.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "quota",
    "AI",
    "Claude",
    "Copilot",
    "Codex",
    "Grok",
    "Cursor",
    "DeepSeek",
    "Kimi",
    "OpenRouter",
    "VS Code",
    "monitoring"
  ],
  "icon": "icons/icon128.png",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiQuotaTool.openPanel",
        "title": "AI Quota Tool: Open Dashboard"
      },
      {
        "command": "aiQuotaTool.configure",
        "title": "AI Quota Tool: Set Up Accounts"
      }
    ],
    "configuration": {
      "title": "AI Quota Tool",
      "properties": {
        "aiQuotaTool.browserPath": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Browser for Account sign-in. `auto` finds Chrome, then Edge. Or type the full path to a Chrome or Edge program file."
        },
        "aiQuotaTool.browserSignIn": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Sign in to Accounts in a separate Chrome or Edge window. The extension reads one session cookie, then deletes the browser profile. Turn off to paste the cookie yourself."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --format=cjs && vite build --config vite.webview.config.ts",
    "dev": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --format=cjs --watch",
    "type-check": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.webview.json --noEmit",
    "clean": "rimraf dist",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-quota-tool/core": "workspace:*",
    "@ai-quota-tool/ui": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^5.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/vsce": "^3.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.25.12",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  }
}
